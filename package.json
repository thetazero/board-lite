{
  "name": "board-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wizards raising dragons: headless rules engine and CLI",
  "bin": {
    "board-lite": "src/cli.ts"
  },
  "scripts": {
    "game": "node src/cli.ts",
    "serve": "node src/server/server.ts",
    "datasheet": "node src/datasheet.ts",
    "analyze": "node src/analyze.ts",
    "typecheck": "tsc && tsc -p web",
    "test": "node --test test/*.test.ts test/design/*.test.ts",
    "ci": "npm run typecheck && npm test",
    "shots": "node src/shots/shots.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
